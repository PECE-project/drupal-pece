{% extends 'paragraph.html.twig' %}

{% if content.field_pece_image_artifact[0] %}
  {% set imagepath = path('entity.node.canonical', {'node':  content.field_pece_image_artifact.0['#node'].id}) %}
  {% set artifact_title = content.field_pece_image_artifact.0['#node'].label %}
{% endif %}

{% block content %}
  <div class="columns is-justify-content-center">
    {% if content.field_pece_image_artifact[0] %}
      <div class="column is-half img-container">
        {{ content.field_pece_image_artifact }}
      </div>
    {% else %}
      <div class="column is-half img-container missing-content">
        {% trans %}This artifact has been removed from the platform and can no longer be accessed.{% endtrans %}
      </div>
    {% endif %}
    <div class="column is-one-third">
      {% if content.field_pece_image_artifact[0] %}
        <h2{{ title_attributes }}>
          <a href="{{ imagepath }}" rel="bookmark">
            {{ artifact_title }}
          </a>
        </h2>
      {% endif %}
      {{content.field_pece_description}}
    </div>
  </div>
{% endblock %}
